# For compose.yaml on a regular Docker host.
# TrueNAS Apps: use deploy/truenas-compose.yaml; it does not need this file.

# Replace both placeholders with existing absolute paths ON THE SERVER.
# State must be on a local filesystem, outside SMB/NFS/OneDrive folders.
STATE_DIRECTORY=/mnt/CHANGE_ME/appdata/mail_cloud
PHOTO_LIBRARY=/mnt/CHANGE_ME/photos

# Container UID/GID. Both mounted paths must grant this identity access.
# /state: read/write; /photos: read/traverse. The image defaults to 1000:1000.
PUID=1000
PGID=1000

# Published host port; the container listens on 8787.
MAILRU_PORT=31800

# Comma-separated host names/IPs used in the browser, without scheme or port.
# This checks HTTP Host; it does not bind Docker to a network address.
# Example only: replace with your server address.
MAILRU_ALLOWED_HOSTS=192.168.1.10

# Mutable release channel. Compose checks the registry with pull_policy: always.
# Use :v0.7.0 to select that specific release instead of following stable.
MAILRU_IMAGE=ghcr.io/zhalenik/mail_cloud:stable

# Leave empty for direct LAN access. Only set for a reverse proxy, e.g.
# MAILRU_PUBLIC_ORIGIN=https://photos.example.com
MAILRU_PUBLIC_ORIGIN=

# Enter the Mail app password in the UI, not in this file.

# Initial scheduler timezone; saved panel settings take precedence.
MAILRU_TIMEZONE=Europe/Moscow
